<?xml version='1.0' encoding='utf-8' ?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <dashboard-extension id="com.example.extensions.kpicard" extension-version="1.0.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name" />
    <description>Customisable KPI card: title, current period value, up/down delta vs previous month, quarter, or year, and a trend chart.</description>
    <author name="Your Name" email="you@example.com" organization="Your Organisation" website="https://example.com" />
    <min-api-version>1.9</min-api-version>
    <source-location>
      <url>https://your-host.example.com/kpi-card/index.html</url>
    </source-location>
    <icon></icon>
    <permissions>
      <permission>full data</permission>
    </permissions>
  </dashboard-extension>
  <resources>
    <resource id="name">
      <text locale="en_US">KPI Card</text>
    </resource>
  </resources>
</manifest>
